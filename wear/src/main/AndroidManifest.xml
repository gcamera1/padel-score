<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Indica que es una app para reloj -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Contador de golpes: foreground service + muestreo de sensores -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Evitar que Android filtre relojes por features implícitas -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!--
      El targeting a relojes lo hace `uses-feature android.hardware.type.watch` (arriba).
      NO agregar <supports-screens>: esos buckets legacy los usa Play para filtrar
      dispositivos y pueden excluir relojes de pantalla grande.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Companion mode (requires phone) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name="com.gonzalocamera.padelcounter.presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SplashScreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name="com.gonzalocamera.padelcounter.presentation.StrokeCounterService"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>

</manifest>
